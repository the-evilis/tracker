# Настройки бота напоминаний. Шаблон: скопировать в /opt/tracker-bot/.env
# и заполнить (права 600). Файл читает systemd через EnvironmentFile,
# локально — node --env-file=bot/.env bot/index.js.
#
# Имя без точки в начале — намеренно: так шаблон точно не спутать
# с настоящим файлом настроек и не унести в репозиторий вместе с ним.

# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=

# Тот же проект Supabase, что и у приложения.
SUPABASE_URL=https://bjqcjktdbjgmwxcddppq.supabase.co

# Ключ service_role: дашборд Supabase → Project Settings → API Keys.
# Он обходит RLS, поэтому нужен боту (человека в браузере в этот момент нет)
# и поэтому же не должен попадать никуда, кроме этого файла.
SUPABASE_SERVICE_ROLE_KEY=

# Кому напоминать: пары «chat_id:user_id» через запятую.
#   chat_id — числовой id чата в Telegram (свой можно узнать у @userinfobot);
#   user_id — UUID из Supabase → Authentication → Users.
TRACKER_USERS=5612286265:00000000-0000-0000-0000-000000000000

# Когда присылать вечернюю сверку и в каком часовом поясе.
REMIND_AT=21:00
TIMEZONE=Europe/Moscow

# Если бот лежал в момент напоминания, он пришлёт его при старте,
# но не позже чем через столько минут после назначенного времени.
CATCH_UP_MINUTES=120

# Логи и состояние.
LOG_FILE=/var/log/tracker-bot.log
LOG_MAX_BYTES=1048576
LOG_KEEP=3
STATE_FILE=/opt/tracker-bot/state.json

# Таймауты сети.
HTTP_TIMEOUT_MS=15000
POLL_TIMEOUT_SEC=30
