# Настройки служебных скриптов трекера привычек.
# Скопировать в /opt/tracker/.env и заполнить. Файл в git не попадает.

# Адрес проекта Supabase и его публичный anon-ключ.
# Ключ публичный по дизайну (он лежит и в index.html) — данные защищает RLS,
# а не скрытие ключа.
SUPABASE_URL=https://bjqcjktdbjgmwxcddppq.supabase.co
SUPABASE_ANON_KEY=

# Строка подключения к базе для бэкапов.
# Берётся в дашборде: Project Settings → Database → Connection string → URI.
# Содержит пароль базы — настоящий секрет, наружу не отдавать.
SUPABASE_DB_URL=

# Уведомления в Telegram (необязательно).
# Если оба поля пустые, скрипты просто пишут в лог и никуда не сообщают.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=5612286265
